ASPNETCORE_ENVIRONMENT=Production
Notify__PublicUrl=https://notify.alxprgs.tech
Notify__SsoIssuer=https://auth.alxprgs.tech
Notify__OwnerSub=REPLACE_WITH_OWNER_UUID
Notify__WebClientId=notify-web
Notify__WebClientSecret=REPLACE_WITH_CONFIDENTIAL_CLIENT_SECRET
Notify__AndroidClientId=notify-android
Notify__AndroidSigningFingerprints__0=REPLACE_WITH_APK_SIGNING_SHA256
# Explicit public HTTPS hosts; omit until webhooks are used.
# Notify__WebhookHosts__0=agent.example.com
FIREBASE_CREDENTIALS_FILE=/etc/alxprgs-notify/firebase.json
NOTIFY_MEMORY_LIMIT=192m
NOTIFY_CPU_LIMIT=0.5
# Agent liveness (seconds); offline builds on the single server process.
# Notify__AgentHeartbeatSeconds=30
# Notify__AgentOfflineSeconds=90
# Voice storage: quota in bytes, temporary upload TTL, outgoing voice message TTL.
# Notify__AudioQuotaBytes=536870912
# Notify__AudioUploadMinutes=15
# Notify__AudioMessageTtlDays=7
